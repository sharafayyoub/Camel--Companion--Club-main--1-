# La demo /demo/impacto funciona dejando estos valores vacíos.
# Copia este archivo como .env solo para configurar tu propio entorno.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Exclusivamente servidor. Nunca uses el prefijo VITE_ para secretos.
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_DB_MIGRATION_URL=

# Contratación: usar una clave sk_test_ en el entorno de demostración.
STRIPE_SECRET_KEY=
STRIPE_ALLOWED_ORIGINS=http://localhost:8080

# Confirmaciones a través del gateway Resend de Lovable.
RESEND_API_KEY=
LOVABLE_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TEST_RECIPIENT=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
